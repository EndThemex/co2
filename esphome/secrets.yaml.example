# ESPHome 凭证模板：复制本文件为 secrets.yaml 并填入自己的凭证（secrets.yaml 不会入库）
# cp secrets.yaml.example secrets.yaml

# Wi-Fi 凭证：改成你自己的
wifi_ssid: "你的WiFi名称"
wifi_password: "你的WiFi密码"

# HomeAssistant ESPHome API 加密密钥（32 字节 base64），生成命令：
# python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# 注意：该密钥同时用于 API 加密和 OTA 升级加密
api_key: "用上方命令生成的密钥"
